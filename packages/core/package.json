{
  "name": "@autofix/core",
  "version": "0.1.0",
  "private": true,
  "description": "Lógica de dominio pura: motor de cronograma, costos, KPI y esquemas compartidos",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./formulas": {
      "import": {
        "types": "./dist/formulas.d.ts",
        "default": "./dist/formulas.js"
      },
      "require": {
        "types": "./dist/formulas.d.cts",
        "default": "./dist/formulas.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/formulas.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/formulas.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "mathjs": "14.9.1",
    "zod": "^4.6.7"
  }
}
