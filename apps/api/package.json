{
  "name": "@autofix/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de AutoFix Gestión (NestJS)",
  "type": "commonjs",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && prisma migrate deploy && pnpm --filter @autofix/core build && tsc -p tsconfig.build.json && concurrently -k -n core,tsc,api -c cyan,yellow,green \"pnpm --filter @autofix/core dev\" \"tsc -w -p tsconfig.build.json --preserveWatchOutput\" \"nodemon dist/main.js\"",
    "start": "node dist/main.js",
    "test": "prisma generate && vitest run --passWithNoTests",
    "test:bd": "prisma generate && vitest run -c vitest.bd.config.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "caso:xlsx": "tsx scripts/generar-caso-prueba.ts",
    "db:erd": "prisma generate && tsx scripts/generar-modelo-datos.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@autofix/core": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/client": "^6.19.3",
    "exceljs": "4.4.0",
    "multer": "^2.5.0",
    "reflect-metadata": "~0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.20",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.2.5",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
